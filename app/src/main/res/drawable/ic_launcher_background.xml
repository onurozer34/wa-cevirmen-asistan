<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Charcoal-Plum Surface -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#121014"
                android:endX="108"
                android:endY="108"
                android:startColor="#241F26"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Mor Media Works Purple Ambient Glow (#69416F) -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="82"
                android:centerY="26"
                android:gradientRadius="68"
                android:type="radial">
                <item
                    android:color="#5969416F"
                    android:offset="0" />
                <item
                    android:color="#0069416F"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
