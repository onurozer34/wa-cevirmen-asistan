<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_card"
    android:elevation="12dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:background="#69416F" />

    <!-- Draggable Compact Header Row -->
    <LinearLayout
        android:id="@+id/headerDragArea"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_btn_primary">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_spark" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="WA Asistan"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/langBadge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_lang_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp">

            <TextView
                android:id="@+id/txtSourceLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTO"
                android:textColor="#69416F"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TR"
                android:textColor="#69416F"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Küçült veya Genişlet"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_up" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Kapat"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#141A1A1A" />

    <!-- Collapsible Content -->
    <LinearLayout
        android:id="@+id/panelBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp">

        <!-- Side-by-Side Resizable Scrollable Boxes -->
        <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Left Box: Customer Message(s) Translated to Turkish -->
            <ScrollView
                android:id="@+id/scrollTranslation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_subcard"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true"
                android:padding="10dp"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/txtTurkishTranslation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2.5dp"
                    android:text="Çevirmek için mesaja dokunun..."
                    android:textColor="#1A1A1A"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>

            <!-- Right Box: Drafted Foreign Reply + Turkish Back-Translation -->
            <ScrollView
                android:id="@+id/scrollReply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_subcard_accent"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true"
                android:padding="10dp"
                android:scrollbarSize="3dp"
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtForeignReply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2.5dp"
                        android:text="Onayınız için yanıt burada hazırlanacak..."
                        android:textColor="#1A1A1A"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/replyDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="6dp"
                        android:background="#2669416F"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtReplyTrMeaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#69416F"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Bottom Action Row: [Instruction Input] [Uygula] [Down-Arrow to WhatsApp Box] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtInstruction"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Düzenleme / ekleme yazın..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#1A1A1A"
                android:textColorHint="#731A1A1A"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/btnApplyInstruction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_spark" />

                <TextView
                    android:id="@+id/txtApplyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Uygula"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnWriteToBox"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Onayla ve WhatsApp kutusuna indir"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_insert_box"
                android:tint="#69416F" />
        </LinearLayout>

        <!-- Compact Status Line -->
        <TextView
            android:id="@+id/txtStatusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#69416F"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Bottom Vertical Resize Handle -->
        <FrameLayout
            android:id="@+id/resizeHandle"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:clickable="true"
            android:contentDescription="Pencere yüksekliğini sürükleyerek ayarlayın">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_resize_grip" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
